config-version = 2
start-at-login = true

[gaps]
inner.horizontal = 8
inner.vertical = 8
outer.left = 8
outer.bottom = 8
outer.top = 8
outer.right = 8

[mode.main.binding]
alt-enter = 'exec-and-forget open -a Ghostty'
alt-b = 'exec-and-forget open -a "Brave Browser"'
alt-e = 'exec-and-forget open -a Finder'
alt-s = 'exec-and-forget open -a Spotify'
alt-w = 'exec-and-forget open -a WhatsApp'
alt-y = 'exec-and-forget open "https://www.youtube.com"'
alt-g = 'exec-and-forget open "https://gemini.google.com"'
alt-m = 'exec-and-forget open "https://www.miruro.to"'
alt-r = 'exec-and-forget open "https://www.reddit.com"'

alt-1 = 'workspace 1'
alt-2 = 'workspace 2'
alt-3 = 'workspace 3'
alt-4 = 'workspace 4'
alt-5 = 'workspace 5'

alt-shift-1 = 'move-node-to-workspace 1'
alt-shift-2 = 'move-node-to-workspace 2'
alt-shift-3 = 'move-node-to-workspace 3'
alt-shift-4 = 'move-node-to-workspace 4'
alt-shift-5 = 'move-node-to-workspace 5'

alt-h = 'focus left'
alt-j = 'focus down'
alt-k = 'focus up'
alt-l = 'focus right'

alt-shift-h = 'move left'
alt-shift-j = 'move down'
alt-shift-k = 'move up'
alt-shift-l = 'move right'

# --- App to Workspace Bindings ---

# Bind Brave Browser to Workspace 1
[[on-window-detected]]
if.app-name-regex-substring = 'Brave'
run = 'move-node-to-workspace 1'

# Bind Ghostty to Workspace 2
[[on-window-detected]]
if.app-name-regex-substring = 'Ghostty'
run = 'move-node-to-workspace 2'

# Bind WhatsApp to Workspace 3
[[on-window-detected]]
if.app-name-regex-substring = 'WhatsApp'
run = 'move-node-to-workspace 3'

# Bind Spotify to Workspace 4
[[on-window-detected]]
if.app-name-regex-substring = 'Spotify'
run = 'move-node-to-workspace 4'
